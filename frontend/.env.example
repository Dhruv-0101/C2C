# ==============================================================================
# 🚀 BrandFlow Frontend Environment Template (.env.example)
# ------------------------------------------------------------------------------
# 📌 INSTRUCTIONS FOR COLLABORATORS:
# 1. Copy this file to `.env`: (run `cp .env.example .env` or `copy .env.example .env`)
# 2. Local development works out-of-the-box!
# ==============================================================================

# Active Environment Mode ('development' | 'production')
VITE_APP_ENV=development

# Environment API Endpoints (Local Dev vs AWS EC2 Prod vs Vercel-Render)
VITE_API_BASE_URL_DEV="http://localhost:5000/api/v1"
VITE_API_BASE_URL_AWS="https://your-server-domain.sslip.io/api/v1"
VITE_API_BASE_URL_PROD="https://your-backend.onrender.com/api/v1"

# Google OAuth 2.0 Client Credentials
VITE_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
