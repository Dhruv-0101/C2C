# ==============================================================================
# BrandFlow Enterprise Environment Variables Template (.env.example)
# ------------------------------------------------------------------------------
# Copy this file to .env before running docker compose up or local dev servers.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Application runtime environment ('development' | 'production' | 'test')
NODE_ENV=development

# Express Backend Server listening port
PORT=5000

# Vite React Frontend Dev Server listening port
VITE_PORT=5173

# ------------------------------------------------------------------------------
# 2. POSTGRESQL RELATIONAL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL Superuser account name
POSTGRES_USER=postgres

# PostgreSQL Superuser account password
POSTGRES_PASSWORD=your_secure_db_password_here

# Primary database name for BrandFlow platform
POSTGRES_DB=brandflow_db

# PostgreSQL host listening port
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. PRISMA ORM DATABASE CONNECTION URL
# ------------------------------------------------------------------------------
# Connection string used by Express Backend & Prisma Client
DATABASE_URL="postgresql://postgres:your_secure_db_password_here@postgres:5432/brandflow_db?schema=public"

# ------------------------------------------------------------------------------
# 4. REDIS IN-MEMORY STORE & BULLMQ QUEUE CONFIGURATION
# ------------------------------------------------------------------------------
# Redis server host (uses Docker service name 'redis' or 'localhost')
REDIS_HOST=redis

# Redis server listening port
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 5. INITIAL SUPERADMIN BOOTSTRAP CREDENTIALS (PRISMA SEED)
# ------------------------------------------------------------------------------
# Initial SuperAdmin email created on first seed run ('npm run db:seed')
INITIAL_ADMIN_EMAIL=admin@brandflow.com

# Initial SuperAdmin password created on first seed run ('npm run db:seed')
INITIAL_ADMIN_PASSWORD=ChangeMeInProduction123!

# Initial SuperAdmin display name
INITIAL_ADMIN_NAME="Super Admin"

# ------------------------------------------------------------------------------
# 6. JWT AUTHENTICATION SECRETS & KEYS
# ------------------------------------------------------------------------------
# Secret key for signing short-lived access JWT tokens (15m)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here

# Secret key for signing long-lived refresh JWT tokens (7d)
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# ------------------------------------------------------------------------------
# 7. FRONTEND & CORS CROSS-ORIGIN URLS
# ------------------------------------------------------------------------------
# Allowed Client Application origin URL for CORS policy in Express
CLIENT_URL=http://localhost:5173

# API Base URL used by Frontend Axios & TanStack Query requests
VITE_API_BASE_URL=http://localhost:5000/api/v1
