# ==============================================================================
# 🚀 BrandFlow Enterprise Root & Docker Environment Template (.env.example)
# ------------------------------------------------------------------------------
# 📌 INSTRUCTIONS FOR COLLABORATORS:
# 1. Copy this file to `.env`: (run `cp .env.example .env` or `copy .env.example .env`)
# 2. If running with Docker (`docker compose up -d`): Local development works out-of-the-box!
# 3. Replace all dummy values below with your own credentials if needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SERVER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
VITE_PORT=5173
ENABLE_RATE_LIMITER="false"

# ------------------------------------------------------------------------------
# 2. POSTGRESQL RELATIONAL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword123
POSTGRES_DB=brandflow_db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. PRISMA ORM DATABASE CONNECTION URL
# ------------------------------------------------------------------------------
# Docker internal network database connection:
DATABASE_URL="postgresql://postgres:postgrespassword123@brandflow-postgres:5432/brandflow_db?schema=public"
DATABASE_URL_DEV="postgresql://postgres:postgrespassword123@localhost:5433/brandflow_db?schema=public"
DATABASE_URL_PROD="postgresql://username:password@your-cloud-database-host:5432/brandflow_db?sslmode=require"

# ------------------------------------------------------------------------------
# 4. REDIS IN-MEMORY STORE & BULLMQ QUEUE CONFIGURATION
# ------------------------------------------------------------------------------
REDIS_HOST=brandflow-redis
REDIS_PORT=6379

REDIS_HOST_DEV="127.0.0.1"
REDIS_PORT_DEV=6379
REDIS_PASSWORD_DEV=""
REDIS_TLS_DEV="false"

REDIS_HOST_PROD="your-redis-host.upstash.io"
REDIS_PORT_PROD=6379
REDIS_PASSWORD_PROD="your_redis_password_here"
REDIS_TLS_PROD="true"

# ------------------------------------------------------------------------------
# 5. INITIAL SUPERADMIN BOOTSTRAP CREDENTIALS (PRISMA SEED)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@brandflow.com
INITIAL_ADMIN_PASSWORD=YourAdminPassword123!
INITIAL_ADMIN_NAME="Super Admin"

# ------------------------------------------------------------------------------
# 6. JWT AUTHENTICATION SECRETS & KEYS
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 7. FRONTEND & CORS CROSS-ORIGIN URLS (Local vs AWS EC2 vs Vercel-Render)
# ------------------------------------------------------------------------------
CLIENT_URL=http://localhost:5173
CLIENT_URL_DEV="http://localhost:5173"
CLIENT_URL_AWS="https://your-server-domain.sslip.io"
CLIENT_URL_PROD="https://your-frontend.vercel.app"

VITE_API_BASE_URL_DEV="http://localhost:5000/api/v1"
VITE_API_BASE_URL_AWS="https://your-server-domain.sslip.io/api/v1"
VITE_API_BASE_URL_PROD="https://your-backend.onrender.com/api/v1"
VITE_API_BASE_URL=http://localhost:5000/api/v1

# ------------------------------------------------------------------------------
# 8. GOOGLE OAUTH 2.0 CREDENTIALS
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ------------------------------------------------------------------------------
# 9. NODEMAILER / GMAIL SMTP EMAIL CONFIGURATION
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_16_character_app_password"
FROM_EMAIL="your_email@gmail.com"

# ------------------------------------------------------------------------------
# 10. CLOUDINARY MEDIA STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ------------------------------------------------------------------------------
# 11. META / INSTAGRAM GRAPH API CONFIGURATION
# ------------------------------------------------------------------------------
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_REDIRECT_URI="https://your-domain.com/api/v1/social/meta/callback"

# ------------------------------------------------------------------------------
# 12. LINKEDIN OAUTH 2.0 CONFIGURATION
# ------------------------------------------------------------------------------
LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"
LINKEDIN_REDIRECT_URI="https://your-domain.com/api/v1/social/linkedin/callback"

# ------------------------------------------------------------------------------
# 13. SOCIAL PUBLISHER & ENCRYPTION
# ------------------------------------------------------------------------------
SOCIAL_TOKEN_ENCRYPTION_KEY="your_32_character_encryption_key_here"
SOCIAL_PUBLISHER_MODE="SANDBOX"

# ------------------------------------------------------------------------------
# 14. DUAL PAYMENT GATEWAYS (RAZORPAY & STRIPE DIRECT API)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"

# ------------------------------------------------------------------------------
# 15. AI CAPTION & HASHTAG GENERATION API KEYS
# ------------------------------------------------------------------------------
OPENAI_API_KEY="sk-your-openai-api-key"
GEMINI_API_KEY="your-gemini-api-key"
