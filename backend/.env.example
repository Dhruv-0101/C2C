PORT=5000
NODE_ENV=development

# Enable or Disable Express Rate Limiter ("true" | "false")
ENABLE_RATE_LIMITER="true"

# Google OAuth 2.0 Client Credentials
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ==========================================
# DATABASE & POSTGRES CONFIGURATION (DEV vs PROD)
# ==========================================
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DB="brandflow_db"
POSTGRES_PORT=5432

DATABASE_URL_DEV="postgresql://postgres:your_postgres_password@localhost:5432/brandflow_db?schema=public"
DATABASE_URL_PROD="postgresql://neondb_owner:your_neon_password@ep-divine-base-avokpx6v-pooler.c-11.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/brandflow_db?schema=public"

# ==========================================
# CLIENT APPLICATION URL (DEV vs PROD)
# ==========================================
CLIENT_URL_DEV="http://localhost:5173"
CLIENT_URL_PROD="https://c2-c-puce.vercel.app"
CLIENT_URL="http://localhost:5173"

# ==========================================
# JWT AUTHENTICATION SECRETS & EXPIRATIONS
# ==========================================
JWT_ACCESS_SECRET="your_jwt_access_secret_key_at_least_16_chars"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_at_least_16_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ==========================================
# SMTP EMAIL CONFIGURATION
# ==========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
FROM_EMAIL="welcome@brandflow.ai"

# ==========================================
# REDIS QUEUE CONFIGURATION (DEV vs PROD)
# ==========================================
REDIS_HOST_DEV="127.0.0.1"
REDIS_PORT_DEV=6379
REDIS_PASSWORD_DEV=""
REDIS_TLS_DEV="false"

REDIS_HOST_PROD="leading-dane-144829.upstash.io"
REDIS_PORT_PROD=6379
REDIS_PASSWORD_PROD="your_upstash_redis_password"
REDIS_TLS_PROD="true"

# ==========================================
# CLOUDINARY MEDIA STORAGE CONFIGURATION
# ==========================================
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ==========================================
# META / INSTAGRAM GRAPH API CONFIGURATION
# ==========================================
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_REDIRECT_URI="https://c2c-negk.onrender.com/api/v1/social/meta/callback"

# ==========================================
# LINKEDIN OAUTH 2.0 CONFIGURATION
# ==========================================
LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"
LINKEDIN_REDIRECT_URI="https://c2c-negk.onrender.com/api/v1/social/linkedin/callback"

# Social Token AES-256 Encryption & Publisher Mode ('LIVE' or 'MOCK')
SOCIAL_TOKEN_ENCRYPTION_KEY="your_32_byte_social_encryption_key"
SOCIAL_PUBLISHER_MODE="MOCK"
