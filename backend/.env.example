# ==============================================================================
# 🚀 BrandFlow Backend Environment Template (.env.example)
# ------------------------------------------------------------------------------
# 📌 INSTRUCTIONS FOR COLLABORATORS:
# 1. Copy this file to `.env`: (run `cp .env.example .env` or `copy .env.example .env`)
# 2. Put your local database configuration and third-party test API keys below.
# ==============================================================================

PORT=5000
NODE_ENV=development

# Enable or Disable Express Rate Limiter (set "false" in dev to disable brute-force throttling)
ENABLE_RATE_LIMITER="false"

# Google OAuth 2.0 Client Credentials
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ==========================================
# 🗄️ DATABASE & POSTGRES CONFIGURATION (DEV vs PROD)
# ==========================================
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DB="brandflow_db"
POSTGRES_PORT=5433

DATABASE_URL_DEV="postgresql://postgres:your_postgres_password@localhost:5433/brandflow_db?schema=public"
DATABASE_URL_PROD="postgresql://username:password@your-cloud-database-host:5432/brandflow_db?sslmode=require"
DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5433/brandflow_db?schema=public"

# ==========================================
# 🌐 CLIENT APPLICATION URL (Local vs AWS EC2 vs Vercel)
# ==========================================
CLIENT_URL_DEV="http://localhost:5173"
CLIENT_URL_AWS="https://your-server-domain.sslip.io"
CLIENT_URL_PROD="https://your-frontend.vercel.app"
CLIENT_URL="http://localhost:5173"

# ==========================================
# 🔐 JWT AUTHENTICATION SECRETS & EXPIRATIONS
# ==========================================
JWT_ACCESS_SECRET="your_jwt_access_secret_key_minimum_32_characters_long"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_minimum_32_characters_long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ==========================================
# 📧 NODEMAILER / GMAIL SMTP EMAIL CONFIGURATION
# ==========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_16_character_app_password"
FROM_EMAIL="your_email@gmail.com"

# ==========================================
# ⚡ REDIS QUEUE CONFIGURATION
# ==========================================
REDIS_HOST_DEV="127.0.0.1"
REDIS_PORT_DEV=6379
REDIS_PASSWORD_DEV=""
REDIS_TLS_DEV="false"

REDIS_HOST_PROD="your-redis-host.upstash.io"
REDIS_PORT_PROD=6379
REDIS_PASSWORD_PROD="your_redis_password_here"
REDIS_TLS_PROD="true"

# ==========================================
# ☁️ CLOUDINARY MEDIA STORAGE CONFIGURATION
# ==========================================
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ==========================================
# 📸 META / INSTAGRAM GRAPH API CONFIGURATION
# ==========================================
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_REDIRECT_URI="https://your-domain.com/api/v1/social/meta/callback"

# ==========================================
# 💼 LINKEDIN OAUTH 2.0 CONFIGURATION
# ==========================================
LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"
LINKEDIN_REDIRECT_URI="https://your-domain.com/api/v1/social/linkedin/callback"

# ==========================================
# 📢 SOCIAL PUBLISHER & ENCRYPTION
# ==========================================
SOCIAL_TOKEN_ENCRYPTION_KEY="your_32_character_encryption_key_here"
SOCIAL_PUBLISHER_MODE="SANDBOX"

# ==========================================
# 💳 DUAL PAYMENT GATEWAYS (RAZORPAY & STRIPE DIRECT API)
# ==========================================
RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"

# INITIAL SUPERADMIN CREDENTIALS
INITIAL_ADMIN_EMAIL=admin@brandflow.com
INITIAL_ADMIN_PASSWORD=YourAdminPassword123!
INITIAL_ADMIN_NAME="Super Admin"
