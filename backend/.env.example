PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword2026@localhost:5432/brandflow_db?schema=public"

# JWT Authentication Secrets & Expirations
JWT_ACCESS_SECRET="your_jwt_access_secret_key_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_here"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Client Application URL (CORS)
CLIENT_URL="http://localhost:5173"

# SMTP Email Configuration (Optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@example.com"
SMTP_PASS="your_app_password"
FROM_EMAIL="noreply@brandflow.ai"

# Redis & BullMQ Queue Configuration (Optional / Local Docker)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_TLS="false"
