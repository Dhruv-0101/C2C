PORT=5000
NODE_ENV=development

# ==========================================
# DATABASE CONFIGURATION (DEV vs PROD)
# ==========================================
DATABASE_URL_DEV="postgresql://postgres:postgrespassword2026@localhost:5432/brandflow_db?schema=public"
DATABASE_URL_PROD="postgresql://neondb_owner:your_neon_password@ep-divine-base-avokpx6v-pooler.c-11.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL="postgresql://postgres:postgrespassword2026@localhost:5432/brandflow_db?schema=public"

# ==========================================
# CLIENT APPLICATION URL (DEV vs PROD)
# ==========================================
CLIENT_URL_DEV="http://localhost:5173"
CLIENT_URL_PROD="https://brandflow-ai.vercel.app"
CLIENT_URL="http://localhost:5173"

# ==========================================
# JWT AUTHENTICATION SECRETS & EXPIRATIONS
# ==========================================
JWT_ACCESS_SECRET="your_jwt_access_secret_key_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_here"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ==========================================
# SMTP EMAIL CONFIGURATION
# ==========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@example.com"
SMTP_PASS="your_app_password"
FROM_EMAIL="noreply@brandflow.ai"

# ==========================================
# REDIS QUEUE CONFIGURATION (DEV vs PROD)
# ==========================================
REDIS_HOST_DEV="127.0.0.1"
REDIS_PORT_DEV=6379
REDIS_PASSWORD_DEV=""
REDIS_TLS_DEV="false"

REDIS_HOST_PROD="leading-dane-144829.upstash.io"
REDIS_PORT_PROD=6379
REDIS_PASSWORD_PROD="your_upstash_redis_password"
REDIS_TLS_PROD="true"
