{
  "info": {
    "_postman_id": "bf-billing-v2",
    "name": "BrandFlow — Billing & Revenue Collection",
    "description": "API endpoints for Subscription Plans, Razorpay, Stripe, Invoicing, and Admin Ledger.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Get Subscription Status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/billing/status",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "billing",
            "status"
          ]
        },
        "description": "Fetches active user plan tier, remaining credits, and quota breakdown."
      }
    },
    {
      "name": "2. Get Billing History",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/billing/history?page=1&limit=10",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "billing",
            "history"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        },
        "description": "Fetches paginated payment and billing transaction history for user."
      }
    },
    {
      "name": "3. Activate Free Plan",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/billing/free/activate",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "billing",
            "free",
            "activate"
          ]
        },
        "description": "Activates starter free plan with 5 complimentary post credits."
      }
    },
    {
      "name": "4. Create Razorpay Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"postCount\": 30\n}"
        },
        "url": {
          "raw": "{{base_url}}/billing/razorpay/create-order",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "billing",
            "razorpay",
            "create-order"
          ]
        },
        "description": "Initializes a dynamic Pro tier purchase order via Razorpay."
      }
    },
    {
      "name": "5. Verify Razorpay Payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"order_xxx\",\n  \"paymentId\": \"pay_xxx\",\n  \"signature\": \"razorpay_hmac_signature\",\n  \"postCount\": 30\n}"
        },
        "url": {
          "raw": "{{base_url}}/billing/razorpay/verify",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "billing",
            "razorpay",
            "verify"
          ]
        },
        "description": "Verifies HMAC SHA256 signature and upgrades user to PRO with allocated post credits."
      }
    },
    {
      "name": "6. Create Stripe PaymentIntent",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"postCount\": 50\n}"
        },
        "url": {
          "raw": "{{base_url}}/billing/stripe/create-intent",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "billing",
            "stripe",
            "create-intent"
          ]
        },
        "description": "Creates a Stripe PaymentIntent for international credit card checkout."
      }
    },
    {
      "name": "7. Verify Stripe Payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"intentId\": \"pi_xxx\",\n  \"postCount\": 50\n}"
        },
        "url": {
          "raw": "{{base_url}}/billing/stripe/verify",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "billing",
            "stripe",
            "verify"
          ]
        },
        "description": "Verifies Stripe payment intent and credits post quota."
      }
    },
    {
      "name": "8. Download Invoice PDF",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/billing/invoice/:transactionId/download",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "billing",
            "invoice",
            ":transactionId",
            "download"
          ],
          "variable": [
            {
              "key": "transactionId",
              "value": "transaction_uuid_here"
            }
          ]
        },
        "description": "Generates and downloads a branded PDF tax invoice."
      }
    },
    {
      "name": "9. Admin — Top-up Bonus Quota",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bonusPosts\": 20\n}"
        },
        "url": {
          "raw": "{{base_url}}/billing/admin/topup/:userId",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "billing",
            "admin",
            "topup",
            ":userId"
          ],
          "variable": [
            {
              "key": "userId",
              "value": "target_user_uuid"
            }
          ]
        },
        "description": "Grants complimentary bonus post credits to a user. (Admin only)"
      }
    },
    {
      "name": "10. Admin — Financial Overview",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/billing/admin/overview",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "billing",
            "admin",
            "overview"
          ]
        },
        "description": "Financial KPI summary, MRR, gateway distribution, and subscription breakdown. (Admin only)"
      }
    },
    {
      "name": "11. Admin — Billing Transactions Ledger",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/billing/admin/transactions?page=1&limit=10",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "billing",
            "admin",
            "transactions"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "currency",
              "value": "INR",
              "disabled": true
            },
            {
              "key": "plan",
              "value": "PRO",
              "disabled": true
            },
            {
              "key": "paymentGateway",
              "value": "RAZORPAY",
              "disabled": true
            }
          ]
        },
        "description": "Immutable financial transactions ledger. (Admin only)"
      }
    },
    {
      "name": "12. Admin — Record Manual Transaction",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"user_uuid_here\",\n  \"plan\": \"PRO\",\n  \"transactionType\": \"PLAN_PURCHASE\",\n  \"paymentGateway\": \"ADMIN_MANUAL\",\n  \"pricePaid\": 999,\n  \"currency\": \"INR\",\n  \"postCount\": 100,\n  \"paymentId\": \"manual_offline_bank_transfer_001\",\n  \"status\": \"COMPLETED\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/billing/admin/manual-transaction",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "billing",
            "admin",
            "manual-transaction"
          ]
        },
        "description": "Records an offline wire/cash transaction and allocates post quota. (Admin only)"
      }
    },
    {
      "name": "13. Admin — Export Transactions CSV",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/billing/admin/export?currency=INR",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "billing",
            "admin",
            "export"
          ],
          "query": [
            {
              "key": "currency",
              "value": "INR"
            }
          ]
        },
        "description": "Exports audit-compliant financial ledger CSV. (Admin only)"
      }
    }
  ]
}