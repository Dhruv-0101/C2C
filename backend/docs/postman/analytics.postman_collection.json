{
  "info": {
    "_postman_id": "bf-analytics-v2",
    "name": "BrandFlow — Analytics & Reporting Collection",
    "description": "API endpoints for Performance Overview, Trends, Platform Breakdown, and Top Templates.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Get Overview KPI Metrics",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/analytics/overview?period=30d",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "analytics",
            "overview"
          ],
          "query": [
            {
              "key": "period",
              "value": "30d"
            }
          ]
        },
        "description": "Fetches total posts created, scheduled, published, and engagement KPIs."
      }
    },
    {
      "name": "2. Get Daily Performance Trends",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/analytics/trends?period=30d",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "analytics",
            "trends"
          ],
          "query": [
            {
              "key": "period",
              "value": "30d"
            }
          ]
        },
        "description": "Fetches day-by-day creation and publication volume trends."
      }
    },
    {
      "name": "3. Get Platform Breakdown",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/analytics/platform-breakdown?period=30d",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "analytics",
            "platform-breakdown"
          ],
          "query": [
            {
              "key": "period",
              "value": "30d"
            }
          ]
        },
        "description": "Distribution of published posts across Instagram and LinkedIn."
      }
    },
    {
      "name": "4. Get Top Performing Templates",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/analytics/top-templates?limit=5",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "analytics",
            "top-templates"
          ],
          "query": [
            {
              "key": "limit",
              "value": "5"
            }
          ]
        },
        "description": "Fetches the most popular graphic templates by post creation volume."
      }
    },
    {
      "name": "5. Seed Demo Analytics Data",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/analytics/demo-seed",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "analytics",
            "demo-seed"
          ]
        },
        "description": "Seeds realistic mock post and analytics records for testing and charts."
      }
    }
  ]
}