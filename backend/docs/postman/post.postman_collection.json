{
  "info": {
    "_postman_id": "bf-posts-module-v2",
    "name": "BrandFlow — Post Collection",
    "description": "API endpoints for saving, scheduling, instant publishing, and deleting user-composited social media marketing posts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Get User Posts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/posts?page=1&limit=10",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "posts"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        },
        "description": "Fetches paginated composited posts created by the authenticated user."
      }
    },
    {
      "name": "2. Get Scheduled Posts Queue",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/posts/scheduled?page=1&limit=10",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "posts",
            "scheduled"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        },
        "description": "Fetches the scheduled posts queue for the authenticated user."
      }
    },
    {
      "name": "3. Publish Post Now",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"postId\": \"post_id_here\",\n  \"postContent\": \"Celebrating Diwali with our valued customers! 🪔✨\",\n  \"graphicUrl\": \"https://res.cloudinary.com/demo/image/upload/v1/sample.png\",\n  \"targetPlatforms\": [\"INSTAGRAM\", \"FACEBOOK\", \"LINKEDIN\"]\n}"
        },
        "url": {
          "raw": "{{base_url}}/posts/publish-now",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "posts",
            "publish-now"
          ]
        },
        "description": "Instantly publishes a composited graphic post across connected social media platforms."
      }
    },
    {
      "name": "4. Schedule Post",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"postId\": \"post_id_here\",\n  \"postContent\": \"Exclusive Festive Discounts on MG Road!\",\n  \"graphicUrl\": \"https://res.cloudinary.com/demo/image/upload/v1/sample.png\",\n  \"scheduledFor\": \"2026-11-08T09:00:00.000Z\",\n  \"targetPlatforms\": [\"INSTAGRAM\", \"LINKEDIN\"]\n}"
        },
        "url": {
          "raw": "{{base_url}}/posts/schedule",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "posts",
            "schedule"
          ]
        },
        "description": "Schedules a composited post for automatic social media publishing at a future date & time."
      }
    },
    {
      "name": "5. Trigger Scheduled Jobs Dispatcher",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/posts/trigger-scheduled-jobs",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "posts",
            "trigger-scheduled-jobs"
          ]
        },
        "description": "Manually triggers the background cron dispatcher cycle to process due scheduled posts."
      }
    },
    {
      "name": "6. Create Post",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"templateId\": \"clx123templateid\",\n  \"festivalId\": \"clx789festivalid\",\n  \"categoryId\": \"clx111categoryid\",\n  \"frameId\": \"clx456frameid\",\n  \"occasionName\": \"Diwali Celebration Post\",\n  \"caption\": \"Happy Diwali from Sunrise Real Estate! #Diwali2026\",\n  \"finalGraphicUrl\": \"https://res.cloudinary.com/demo/image/upload/v1/sample.png\",\n  \"status\": \"DRAFT\",\n  \"userConfigJson\": {\n    \"businessName\": \"Sunrise Real Estate\",\n    \"phone\": \"+91 99999 88888\",\n    \"address\": \"MG Road, Mumbai\",\n    \"tagline\": \"Premium Housing Solutions\"\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/posts",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "posts"
          ]
        },
        "description": "Saves a composited 1080x1080 post image strictly to Cloudinary 'brandflow/posts', database, and Vault with optional categoryId, frameId, templateId, and festivalId references."
      }
    },
    {
      "name": "7. Delete Post",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/posts/:id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "posts",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "post_id_here"
            }
          ]
        },
        "description": "Deletes a composited post by ID and cleans up associated image from Cloudinary storage."
      }
    },
    {
      "name": "8. Admin — Get All Generated Posts (Audit & Filter)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/posts/admin/all?page=1&limit=10&categoryId=&frameId=&templateCategoryId=&festivalId=&status=&search=",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "posts",
            "admin",
            "all"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "categoryId",
              "value": "",
              "disabled": true
            },
            {
              "key": "frameId",
              "value": "",
              "disabled": true
            },
            {
              "key": "templateCategoryId",
              "value": "",
              "disabled": true
            },
            {
              "key": "festivalId",
              "value": "",
              "disabled": true
            },
            {
              "key": "status",
              "value": "DRAFT",
              "disabled": true
            },
            {
              "key": "search",
              "value": "",
              "disabled": true
            }
          ]
        },
        "description": "Admin & SubAdmin audit endpoint to view all user-generated posts across the platform with cross-dimensional filtering by business category, frame overlay, template category, festival, and publishing status."
      }
    },
    {
      "name": "9. Admin — Get Post Analytics & Volume Breakdown",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/posts/admin/analytics",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "posts",
            "admin",
            "analytics"
          ]
        },
        "description": "Fetches aggregated platform post counts (total, draft, scheduled, published) and volume distribution breakdowns grouped by business category, frame, template category, and festival."
      }
    }
  ]
}