{
  "info": {
    "_postman_id": "bf-post-v2",
    "name": "BrandFlow — User Generated Posts Collection",
    "description": "API endpoints for creating, scheduling, rendering, updating, and publishing posts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Get User Posts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/posts?page=1&limit=10",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "posts"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "status",
              "value": "PUBLISHED",
              "disabled": true
            }
          ]
        },
        "description": "Fetches the authenticated user's posts."
      }
    },
    {
      "name": "2. Get Scheduled Posts Queue",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/posts/scheduled",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "posts",
            "scheduled"
          ]
        },
        "description": "Fetches pending queued scheduled posts for user."
      }
    },
    {
      "name": "3. Create Post (Save Draft / Generated)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"templateId\": null,\n  \"festivalId\": null,\n  \"frameId\": null,\n  \"categoryId\": null,\n  \"occasionName\": \"Diwali Special Offer 2026\",\n  \"caption\": \"May this Diwali bring boundless joy and prosperity to your business! 🪔✨\",\n  \"hashtags\": [\n    \"#Diwali2026\",\n    \"#HappyDiwali\",\n    \"#BrandFlow\"\n  ],\n  \"base64Graphic\": \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==\",\n  \"status\": \"DRAFT\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/posts",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "posts"
          ]
        },
        "description": "Saves a rendered post graphic and deducts subscription credit quota."
      }
    },
    {
      "name": "4. Publish Post Now",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"caption\": \"Live announcement from BrandFlow AI! 🚀\",\n  \"targetPlatforms\": [\n    \"INSTAGRAM\",\n    \"LINKEDIN\"\n  ],\n  \"base64Graphic\": \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/posts/publish-now",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "posts",
            "publish-now"
          ]
        },
        "description": "Immediately publishes the graphic post to connected social media channels."
      }
    },
    {
      "name": "5. Schedule Post for Future",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"caption\": \"Scheduled morning greetings for Diwali!\",\n  \"targetPlatforms\": [\n    \"INSTAGRAM\"\n  ],\n  \"scheduledAt\": \"2026-11-08T09:00:00.000Z\",\n  \"base64Graphic\": \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/posts/schedule",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "posts",
            "schedule"
          ]
        },
        "description": "Queues post for background BullMQ worker execution at scheduled timestamp."
      }
    },
    {
      "name": "6. Re-render & Update Post Graphic",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"base64Graphic\": \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/posts/:id/graphic",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "posts",
            ":id",
            "graphic"
          ],
          "variable": [
            {
              "key": "id",
              "value": "post_uuid_here"
            }
          ]
        },
        "description": "Updates and re-uploads graphic for an existing post without deducting extra subscription quota."
      }
    },
    {
      "name": "7. Delete Post",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/posts/:id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "posts",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "post_uuid_here"
            }
          ]
        },
        "description": "Deletes a post record and deletes image from Cloudinary."
      }
    },
    {
      "name": "8. Admin — Get All Generated Posts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/posts/admin/all?page=1&limit=10",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "posts",
            "admin",
            "all"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "categoryId",
              "value": "",
              "disabled": true
            },
            {
              "key": "frameId",
              "value": "",
              "disabled": true
            },
            {
              "key": "templateCategoryId",
              "value": "",
              "disabled": true
            },
            {
              "key": "festivalId",
              "value": "",
              "disabled": true
            },
            {
              "key": "status",
              "value": "",
              "disabled": true
            }
          ]
        },
        "description": "Global audit of all posts created across the system. (Admin only)"
      }
    },
    {
      "name": "9. Admin — Post Analytics",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/posts/admin/analytics",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "posts",
            "admin",
            "analytics"
          ]
        },
        "description": "Aggregated volume breakdown of generated posts. (Admin only)"
      }
    }
  ]
}