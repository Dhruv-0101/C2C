{
  "info": {
    "_postman_id": "bf-category-v2",
    "name": "BrandFlow — Business Categories Collection",
    "description": "API endpoints for managing 35+ Master Business Categories.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Get All Categories",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/categories?page=1&limit=50",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "categories"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "50"
            },
            {
              "key": "search",
              "value": "",
              "disabled": true
            }
          ]
        },
        "description": "Fetches paginated business categories."
      }
    },
    {
      "name": "2. Get Category By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/categories/:id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "categories",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "category_uuid_here"
            }
          ]
        },
        "description": "Fetches a single business category by its UUID."
      }
    },
    {
      "name": "3. Create Category (Admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Real Estate & Property Management\",\n  \"slug\": \"real-estate-property\",\n  \"description\": \"Real estate brokers, residential builders, property rentals, and construction businesses.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/categories",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "categories"
          ]
        },
        "description": "Creates a new master business category. Requires admin or categories tab permission."
      }
    },
    {
      "name": "4. Update Category (Admin)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Real Estate & Property Consultancy\",\n  \"slug\": \"real-estate-property-consultancy\",\n  \"description\": \"Updated description for real estate and infrastructure businesses.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/categories/:id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "categories",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "category_uuid_here"
            }
          ]
        },
        "description": "Updates a business category name, slug, or description."
      }
    },
    {
      "name": "5. Delete Category (Admin)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/categories/:id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "categories",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "category_uuid_here"
            }
          ]
        },
        "description": "Deletes a business category by ID."
