{
  "info": {
    "_postman_id": "bf-design-styles-v1",
    "name": "BrandFlow — Design Styles Module",
    "description": "API endpoints for Master Design Styles & Color Palettes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get All Master Design Styles",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/design-styles",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "design-styles"
          ]
        }
      }
    },
    {
      "name": "Create Master Design Style",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Gold Luxe Minimalist\",\n  \"slug\": \"gold-luxe-minimalist\",\n  \"primaryColor\": \"#F59E0B\",\n  \"secondaryColor\": \"#1E293B\",\n  \"accentColor\": \"#10B981\",\n  \"fontFamily\": \"Plus Jakarta Sans\",\n  \"previewUrl\": \"https://res.cloudinary.com/demo/image/upload/sample.jpg\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/design-styles",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "design-styles"
          ]
        }
      }
    },
    {
      "name": "Delete Design Style",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/design-styles/:id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "design-styles",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "design_style_id_here"
            }
          ]
        }
      }
    }
  ]
}
