{
  "info": {
    "_postman_id": "bf-auth-v2",
    "name": "BrandFlow — Auth & User Management Collection",
    "description": "API endpoints for User Authentication, RBAC, SubAdmin Management, 2FA, and Profile.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Signup User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password@123\",\n  \"name\": \"John Doe\",\n  \"businessName\": \"Apex Enterprises\",\n  \"mobileNumber\": \"+91 9876543210\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/signup",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "signup"
          ]
        },
        "description": "Registers a new user and returns JWT access & refresh tokens."
      }
    },
    {
      "name": "2. Login User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin1@gmail.com\",\n  \"password\": \"admin1\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Logs in user or admin, returns tokens and profile data."
      }
    },
    {
      "name": "3. Google OAuth Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"credential\": \"google_id_token_jwt_from_client\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/google",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "google"
          ]
        },
        "description": "Verifies Google OAuth ID token and creates or logs in the user."
      }
    },
    {
      "name": "4. Forgot Password Request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/forgot-password",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "forgot-password"
          ]
        },
        "description": "Generates and emails a 15-minute secure password reset token."
      }
    },
    {
      "name": "5. Reset Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"reset_token_from_email\",\n  \"password\": \"NewPassword@123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/reset-password",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "reset-password"
          ]
        },
        "description": "Resets the password with a valid token."
      }
    },
    {
      "name": "6. 2FA Verify Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin1@gmail.com\",\n  \"token\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/2fa/verify-login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "2fa",
            "verify-login"
          ]
        },
        "description": "Verifies TOTP token for 2FA-enabled accounts."
      }
    },
    {
      "name": "7. Refresh Access Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"refresh_token_string\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/refresh",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "refresh"
          ]
        },
        "description": "Rotates and provides a new access token."
      }
    },
    {
      "name": "8. Logout",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/auth/logout",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "logout"
          ]
        },
        "description": "Clears authentication cookies."
      }
    },
    {
      "name": "9. Get User Profile (/me)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/me",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        },
        "description": "Returns profile details of the authenticated user."
      }
    },
    {
      "name": "10. Setup 2FA",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/2fa/setup",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "2fa",
            "setup"
          ]
        },
        "description": "Generates TOTP secret and QR code for authenticator apps."
      }
    },
    {
      "name": "11. Enable 2FA",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/2fa/enable",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "2fa",
            "enable"
          ]
        },
        "description": "Enables 2FA by verifying the 6-digit TOTP code."
      }
    },
    {
      "name": "12. Disable 2FA",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/2fa/disable",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "2fa",
            "disable"
          ]
        },
        "description": "Disables two-factor authentication on the active account."
      }
    },
    {
      "name": "13. SuperAdmin — Create SubAdmin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"SubAdmin Manager\",\n  \"email\": \"subadmin@brandflow.com\",\n  \"password\": \"SubAdmin@123\",\n  \"permissions\": [\n    \"festivals\",\n    \"templates\",\n    \"frames\",\n    \"categories\"\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/subadmin",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "subadmin"
          ]
        },
        "description": "Creates a new SubAdmin with granular RBAC permissions. (SuperAdmin only)"
      }
    },
    {
      "name": "14. SuperAdmin — Get SubAdmins List",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/subadmins?page=1&limit=10",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "subadmins"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "search",
              "value": "",
              "disabled": true
            }
          ]
        },
        "description": "Fetches paginated list of subadmins with assigned permissions. (SuperAdmin only)"
      }
    },
    {
      "name": "15. SuperAdmin — SubAdmin Activity Audit",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/subadmins/activity?page=1&limit=20",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "subadmins",
            "activity"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            },
            {
              "key": "subAdminId",
              "value": "",
              "disabled": true
            },
            {
              "key": "type",
              "value": "all",
              "disabled": true
            },
            {
              "key": "search",
              "value": "",
              "disabled": true
            }
          ]
        },
        "description": "Audits entities created by subadmins across categories, festivals, templates, and frames. (SuperAdmin only)"
      }
    },
    {
      "name": "16. SuperAdmin — Update SubAdmin",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated SubAdmin Name\",\n  \"permissions\": [\n    \"festivals\",\n    \"templates\"\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/subadmin/:id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "subadmin",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "subadmin_user_uuid"
            }
          ]
        },
        "description": "Updates SubAdmin details and tab permissions. (SuperAdmin only)"
      }
    },
    {
      "name": "17. SuperAdmin — Delete SubAdmin",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/subadmin/:id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "subadmin",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "subadmin_user_uuid"
            }
          ]
        },
        "description": "Deletes a SubAdmin account. (SuperAdmin only)"
      }
    },
    {
      "name": "18. Admin — User Directory",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/users?page=1&limit=10",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "users"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "search",
              "value": "",
              "disabled": true
            },
            {
              "key": "role",
              "value": "USER",
              "disabled": true
            }
          ]
        },
        "description": "Fetches paginated list of registered users. (Admin & SuperAdmin)"
      }
    },
    {
      "name": "19. Admin — Toggle User Status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isActive\": false\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/users/:userId/status",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "users",
            ":userId",
            "status"
          ],
          "variable": [
            {
              "key": "userId",
              "value": "target_user_uuid"
            }
          ]
        },
        "description": "Activates or suspends a user account. (Admin & SuperAdmin)"
      }
    }
  ]
}