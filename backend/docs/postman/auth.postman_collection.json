{
  "info": {
    "_postman_id": "bf-auth-module-v4",
    "name": "BrandFlow — Auth Collection",
    "description": "Comprehensive API collection for Auth & Access Control: Public Signup/Login, Google OAuth, Password Reset, TOTP 2FA, SuperAdmin SubAdmin delegation, and Admin User Directory.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Signup User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.success && jsonData.data && jsonData.data.accessToken) {",
              "    pm.environment.set('access_token', jsonData.data.accessToken);",
              "    console.log('✅ Access Token stored in access_token');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Dhruv Sharma\",\n  \"email\": \"user@brandflow.ai\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/signup",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "signup"
          ]
        },
        "description": "Registers a new public user. Returns JWT Access Token & sets HTTP-Only refresh cookie."
      }
    },
    {
      "name": "2. Login User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.success && jsonData.data && jsonData.data.accessToken) {",
              "    pm.environment.set('access_token', jsonData.data.accessToken);",
              "    console.log('✅ Access Token stored in access_token');",
              "}",
              "if (jsonData.data && jsonData.data.require2FA) {",
              "    pm.environment.set('mfa_token', jsonData.data.mfaToken);",
              "    console.log('🔐 2FA Required! MFA Token stored in mfa_token');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"superadmin@brandflow.com\",\n  \"password\": \"SuperAdmin123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Authenticates user credentials. If 2FA is enabled, returns require2FA: true and mfaToken."
      }
    },
    {
      "name": "3. Google OAuth Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idToken\": \"google_id_token_from_client_here\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/google",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "google"
          ]
        },
        "description": "Authenticates user using Google One-Tap / OAuth ID Token."
      }
    },
    {
      "name": "4. Forgot Password Request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@brandflow.ai\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/forgot-password",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "forgot-password"
          ]
        },
        "description": "Sends password reset instructions to user's registered email."
      }
    },
    {
      "name": "5. Reset Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"reset_token_from_email_here\",\n  \"newPassword\": \"NewSecurePass123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/reset-password",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "reset-password"
          ]
        },
        "description": "Resets user password using reset token."
      }
    },
    {
      "name": "6. Verify 2FA Login Challenge",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mfaToken\": \"{{mfa_token}}\",\n  \"code\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/2fa/verify-login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "2fa",
            "verify-login"
          ]
        },
        "description": "Verifies 6-digit TOTP code or recovery code during 2FA login challenge."
      }
    },
    {
      "name": "7. Refresh Access Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/refresh",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "refresh"
          ]
        },
        "description": "Rotates refresh token and returns a new Access Token using HTTP-Only cookie."
      }
    },
    {
      "name": "8. Logout Session",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/auth/logout",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "logout"
          ]
        },
        "description": "Revokes refresh token in database and clears HTTP-Only refresh cookie."
      }
    },
    {
      "name": "9. Get Profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/me",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        },
        "description": "Fetches currently logged-in user profile, role flags, and 2FA status."
      }
    },
    {
      "name": "10. Setup 2FA",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/2fa/setup",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "2fa",
            "setup"
          ]
        },
        "description": "Generates TOTP secret and QR code Data URL for authenticator setup."
      }
    },
    {
      "name": "11. Enable 2FA",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/2fa/enable",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "2fa",
            "enable"
          ]
        },
        "description": "Confirms TOTP code, enables 2FA, and returns single-use backup recovery codes."
      }
    },
    {
      "name": "12. Disable 2FA",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/2fa/disable",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "2fa",
            "disable"
          ]
        },
        "description": "Disables 2FA security on authenticated account."
      }
    },
    {
      "name": "13. Create SubAdmin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Jane Smith (SubAdmin)\",\n  \"email\": \"subadmin@brandflow.com\",\n  \"password\": \"SubAdminPass123!\",\n  \"allowedTabs\": [\"users\", \"analytics\", \"templates\"]\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/subadmin",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "subadmin"
          ]
        },
        "description": "Creates a new SubAdmin account with assigned allowedTabs permissions (SuperAdmin only)."
      }
    },
    {
      "name": "14. List SubAdmins",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/subadmins?page=1&limit=20",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "subadmins"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        },
        "description": "Fetches paginated list of all created SubAdmins and permissions (SuperAdmin only)."
      }
    },
    {
      "name": "15. Update SubAdmin",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"allowedTabs\": [\"users\", \"templates\", \"festivals\", \"frames\"]\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/subadmin/:id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "subadmin",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "subadmin_id_here"
            }
          ]
        },
        "description": "Updates allowedTabs permissions for an existing SubAdmin (SuperAdmin only)."
      }
    },
    {
      "name": "16. Delete SubAdmin",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/subadmin/:id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "subadmin",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "subadmin_id_here"
            }
          ]
        },
        "description": "Deletes a SubAdmin account by ID (SuperAdmin only)."
      }
    },
    {
      "name": "17. Get Users Directory",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/users?page=1&limit=20",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "users"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            },
            {
              "key": "search",
              "value": "dhruv",
              "disabled": true
            }
          ]
        },
        "description": "Fetches paginated directory of registered users (Admin / SuperAdmin only)."
      }
    }
  ]
}