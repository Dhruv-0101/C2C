{
  "info": {
    "_postman_id": "bf-festival-v2",
    "name": "BrandFlow — Festival Calendar Collection",
    "description": "API endpoints for managing 40+ Annual Festival Calendar Events & Banners.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Get All Festivals",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/festivals?page=1&limit=50",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "festivals"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "50"
            },
            {
              "key": "year",
              "value": "2026",
              "disabled": true
            },
            {
              "key": "month",
              "value": "11",
              "disabled": true
            },
            {
              "key": "search",
              "value": "",
              "disabled": true
            }
          ]
        },
        "description": "Fetches festival events with optional date and search filters."
      }
    },
    {
      "name": "2. Get Festival By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/festivals/:id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "festivals",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "festival_uuid_here"
            }
          ]
        },
        "description": "Fetches a single festival event by UUID."
      }
    },
    {
      "name": "3. Create Festival Event (Admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Diwali — Festival of Lights 2026\",\n  \"date\": \"2026-11-08T00:00:00.000Z\",\n  \"description\": \"Grand celebration of prosperity, light, and wisdom.\",\n  \"region\": \"National (India)\",\n  \"base64Image\": \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/festivals",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "festivals"
          ]
        },
        "description": "Creates a festival event with optional cover banner. (Admin / Festivals tab)"
      }
    },
    {
      "name": "4. Update Festival Event (Admin)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Diwali — Grand Festival of Lights 2026\",\n  \"date\": \"2026-11-08T00:00:00.000Z\",\n  \"description\": \"Updated celebration notes for Diwali.\",\n  \"region\": \"National (India)\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/festivals/:id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "festivals",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "festival_uuid_here"
            }
          ]
        },
        "description": "Updates festival event details and cover banner."
      }
    },
    {
      "name": "5. Delete Festival Event (Admin)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/festivals/:id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "festivals",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "festival_uuid_here"
            }
          ]
        },
        "description": "Deletes a festival event and cleans up associated banner from Cloudinary."
      }
    }
  ]
}