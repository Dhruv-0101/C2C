{
  "info": {
    "_postman_id": "bf-festivals-module-v1",
    "name": "BrandFlow — Festival Collection",
    "description": "API endpoints for managing national/cultural festival calendar events, dates, cover banners, and region mappings.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Get All Festivals",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/festivals",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "festivals"
          ]
        },
        "description": "Fetches all upcoming national and regional festival calendar events."
      }
    },
    {
      "name": "2. Create Festival Event",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Diwali — Festival of Lights 2026\",\n  \"date\": \"2026-11-08T00:00:00.000Z\",\n  \"description\": \"Grand celebration of light, prosperity, and wisdom.\",\n  \"region\": \"National (India)\",\n  \"base64Image\": \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/festivals",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "festivals"
          ]
        },
        "description": "Adds a new festival calendar event with optional cover banner image upload to Cloudinary 'brandflow/festivals'."
      }
    },
    {
      "name": "3. Update Festival Event",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Diwali — Grand Festival of Lights 2026\",\n  \"description\": \"Updated description for Diwali celebration.\",\n  \"region\": \"Maharashtra\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/festivals/:id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "festivals",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "festival_id_here"
            }
          ]
        },
        "description": "Updates festival details and cover banner image, cleaning up old cover banner from Cloudinary if replaced."
      }
    },
    {
      "name": "4. Delete Festival Event",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/festivals/:id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "festivals",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "festival_id_here"
            }
          ]
        },
        "description": "Deletes a festival calendar event and removes associated cover banner image from Cloudinary storage."
      }
    }
  ]
}