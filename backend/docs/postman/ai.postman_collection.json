{
  "info": {
    "_postman_id": "bf-ai-v1",
    "name": "BrandFlow — AI Generation Collection",
    "description": "API endpoints for AI Caption Generation and Trending Hashtag Suggestions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Generate AI Caption",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"topic\": \"Navratri Special Offer 20% Off on Real Estate Booking\",\n  \"tone\": \"Professional\",\n  \"platform\": \"INSTAGRAM\",\n  \"language\": \"English\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/ai/generate-caption",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "ai",
            "generate-caption"
          ]
        },
        "description": "Generates AI caption tailored to platform, tone, and user brand kit."
      }
    },
    {
      "name": "2. Suggest Trending Hashtags",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"topic\": \"Festival Offer Real Estate Sale\",\n  \"platform\": \"INSTAGRAM\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/ai/suggest-hashtags",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "ai",
            "suggest-hashtags"
          ]
        },
        "description": "Returns curated list of high-converting, trending hashtags."
      }
    }
  ]
}
