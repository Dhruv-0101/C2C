{
  "info": {
    "_postman_id": "bf-vault-v2",
    "name": "BrandFlow — Vault Collection",
    "description": "API endpoints for User Graphic Vault & Saved Designs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Get Vault Items",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/vault?page=1&limit=20",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "vault"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            },
            {
              "key": "search",
              "value": "",
              "disabled": true
            }
          ]
        },
        "description": "Fetches saved graphic designs in the user vault."
      }
    },
    {
      "name": "2. Get Vault Item By ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/vault/:id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "vault",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "vault_item_uuid"
            }
          ]
        },
        "description": "Fetches single vault graphic design details."
      }
    },
    {
      "name": "3. Update Vault Item",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"occasionName\": \"Updated Festival Marketing Banner\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/vault/:id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "vault",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "vault_item_uuid"
            }
          ]
        },
        "description": "Updates metadata of a vault item."
      }
    },
    {
      "name": "4. Delete Vault Item",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/vault/:id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "vault",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "vault_item_uuid"
            }
          ]
        },
        "description": "Deletes a single item from the vault."
      }
    },
    {
      "name": "5. Bulk Delete Vault Items",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ids\": [\n    \"vault_id_1\",\n    \"vault_id_2\"\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/vault/bulk-delete",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "vault",
            "bulk-delete"
          ]
        },
        "description": "Deletes multiple vault items in a single transaction."
      }
    }
  ]
}