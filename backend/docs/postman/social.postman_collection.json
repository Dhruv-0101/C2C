{
  "info": {
    "_postman_id": "bf-social-v2",
    "name": "BrandFlow — Social Media Accounts Collection",
    "description": "API endpoints for Meta/Instagram & LinkedIn OAuth integration, connection URLs, and account disconnection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Get Connected Accounts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/social/accounts",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "social",
            "accounts"
          ]
        },
        "description": "Fetches list of connected social accounts with token expiration status."
      }
    },
    {
      "name": "2. Get Instagram OAuth URL",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/social/auth-url/instagram",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "social",
            "auth-url",
            "instagram"
          ]
        },
        "description": "Generates Instagram Graph OAuth authorization URL."
      }
    },
    {
      "name": "3. Get LinkedIn OAuth URL",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/social/auth-url/linkedin",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "social",
            "auth-url",
            "linkedin"
          ]
        },
        "description": "Generates LinkedIn OAuth 2.0 authorization URL."
      }
    },
    {
      "name": "4. Meta OAuth Callback",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/social/meta/callback?code=oauth_code_here&state=user_state_here",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "social",
            "meta",
            "callback"
          ],
          "query": [
            {
              "key": "code",
              "value": "oauth_code_here"
            },
            {
              "key": "state",
              "value": "user_state_here"
            }
          ]
        },
        "description": "Handles Meta OAuth redirection and exchanges code for long-lived page access tokens."
      }
    },
    {
      "name": "5. LinkedIn OAuth Callback",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/social/linkedin/callback?code=oauth_code_here&state=user_state_here",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "social",
            "linkedin",
            "callback"
          ],
          "query": [
            {
              "key": "code",
              "value": "oauth_code_here"
            },
            {
              "key": "state",
              "value": "user_state_here"
            }
          ]
        },
        "description": "Handles LinkedIn OAuth redirection and persists access tokens."
      }
    },
    {
      "name": "6. Disconnect Account",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/social/accounts/:platform",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "social",
            "accounts",
            ":platform"
          ],
          "variable": [
            {
              "key": "platform",
              "value": "INSTAGRAM"
            }
          ]
        },
        "description": "Disconnects and wipes credentials for a social platform (INSTAGRAM, LINKEDIN)."
      }
    }
  ]
}