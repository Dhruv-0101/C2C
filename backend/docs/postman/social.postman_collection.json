{
  "info": {
    "_postman_id": "bf-social-v1",
    "name": "BrandFlow — Social Collection",
    "description": "API endpoints for Meta/Instagram and LinkedIn accounts, OAuth redirect flows, and manual account connections.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Get Connected Accounts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/social/accounts",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "social",
            "accounts"
          ]
        },
        "description": "Fetches list of all connected social media accounts for the user."
      }
    },
    {
      "name": "2. Get Instagram OAuth URL",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/social/auth-url/instagram",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "social",
            "auth-url",
            "instagram"
          ]
        },
        "description": "Generates Meta/Instagram OAuth login URL."
      }
    },
    {
      "name": "3. Get LinkedIn OAuth URL",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/social/auth-url/linkedin",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "social",
            "auth-url",
            "linkedin"
          ]
        },
        "description": "Generates LinkedIn OAuth authorization URL."
      }
    },
    {
      "name": "4. Meta OAuth Callback",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/social/meta/callback?code=auth_code_here&state=user_state_here",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "social",
            "meta",
            "callback"
          ],
          "query": [
            {
              "key": "code",
              "value": "auth_code_here"
            },
            {
              "key": "state",
              "value": "user_state_here"
            }
          ]
        },
        "description": "OAuth callback endpoint for Meta / Instagram OAuth code exchange."
      }
    },
    {
      "name": "5. LinkedIn OAuth Callback",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/social/linkedin/callback?code=auth_code_here&state=user_state_here",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "social",
            "linkedin",
            "callback"
          ],
          "query": [
            {
              "key": "code",
              "value": "auth_code_here"
            },
            {
              "key": "state",
              "value": "user_state_here"
            }
          ]
        },
        "description": "OAuth callback endpoint for LinkedIn OAuth code exchange."
      }
    },
    {
      "name": "6. Connect Social Account Manually",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"platform\": \"INSTAGRAM\",\n  \"accountName\": \"sunrise_real_estate\",\n  \"handle\": \"@sunrise_real_estate\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/social/connect-manual",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "social",
            "connect-manual"
          ]
        },
        "description": "Manually connects a social media handle."
      }
    },
    {
      "name": "7. Disconnect Social Account",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/social/accounts/:platform",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "social",
            "accounts",
            ":platform"
          ],
          "variable": [
            {
              "key": "platform",
              "value": "INSTAGRAM"
            }
          ]
        },
        "description": "Disconnects a social media platform account by platform name."
      }
    }
  ]
}