{
  "info": {
    "_postman_id": "bf-template-v2",
    "name": "BrandFlow — Master Templates Collection",
    "description": "API endpoints for managing Graphic Base Templates & Template Categories.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Get Template Categories",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/templates/categories?page=1&limit=50",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "templates",
            "categories"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "50"
            },
            {
              "key": "search",
              "value": "",
              "disabled": true
            }
          ]
        },
        "description": "Fetches template categories (e.g. Festival Celebrations, Daily Quotes, Offers)."
      }
    },
    {
      "name": "2. Create Template Category (Admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Festive Mega Sales\",\n  \"description\": \"Templates designed for holiday flash discounts and retail promotions.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/templates/categories",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "templates",
            "categories"
          ]
        },
        "description": "Creates a new template category taxonomy item. (Admin / Templates tab)"
      }
    },
    {
      "name": "3. Delete Template Category (Admin)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/templates/categories/:id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "templates",
            "categories",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "template_category_uuid"
            }
          ]
        },
        "description": "Deletes a template category by ID."
      }
    },
    {
      "name": "4. Get All Templates",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/templates?page=1&limit=20",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "templates"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            },
            {
              "key": "categoryId",
              "value": "",
              "disabled": true
            },
            {
              "key": "templateCategoryId",
              "value": "",
              "disabled": true
            },
            {
              "key": "festivalId",
              "value": "",
              "disabled": true
            },
            {
              "key": "search",
              "value": "",
              "disabled": true
            }
          ]
        },
        "description": "Fetches paginated system templates with optional category, template category, or festival filters."
      }
    },
    {
      "name": "5. Get Template By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/templates/:id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "templates",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "template_uuid_here"
            }
          ]
        },
        "description": "Fetches single template details by ID."
      }
    },
    {
      "name": "6. Create Template (Admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Diwali Golden Fireworks Template\",\n  \"description\": \"Ultra high-definition festive template for Diwali 2026\",\n  \"templateCategoryId\": null,\n  \"festivalId\": null,\n  \"categoryId\": null,\n  \"base64Image\": \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/templates",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "templates"
          ]
        },
        "description": "Uploads a graphic template (supports Base64 or baseImageUrl) to Cloudinary and saves database record."
      }
    },
    {
      "name": "7. Delete Template (Admin)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/templates/:id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "templates",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "template_uuid_here"
            }
          ]
        },
        "description": "Deletes a graphic template and removes image from Cloudinary."
      }
    }
  ]
}