// Prisma Schema Blueprint for BrandFlow (PostgreSQL)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  END_USER
  ADMIN
  SUB_ADMIN
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  TWITTER
  PINTEREST
  THREADS
  WHATSAPP
}

enum AssetType {
  LOGO
  PRODUCT_PHOTO
  BACKGROUND
  STORE_PHOTO
  OTHER
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

enum PublishStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum PlanType {
  FREE
  PRO
  ENTERPRISE
}

enum NotificationType {
  POST_PUBLISHED
  POST_FAILED
  SYSTEM_ALERT
  BILLING
}

// ==========================================
// MODELS
// ==========================================

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String?
  fullName           String
  role               Role     @default(END_USER)
  isAdmin            Boolean  @default(false)
  isSuperAdmin       Boolean  @default(false)
  isSubAdmin         Boolean  @default(false)
  allowedTabs        String[] @default([])
  isTwoFactorEnabled Boolean  @default(false)
  twoFactorSecret    String?
  backupCodes        String[] @default([])
  isGoogleRegistered Boolean  @default(false)
  googleId           String?  @unique
  isActive           Boolean  @default(true)
  avatarUrl          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  socialAccounts      SocialAccount[]
  brandKit            BrandKit?
  brandAssets         BrandAsset[]
  posts               Post[]
  vaultItems          VaultItem[]
  subscription        Subscription?
  notifications       Notification[]
  templatesCreated    Template[]           @relation("TemplateCreator")

  @@index([email])
  @@index([googleId])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model SocialAccount {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       SocialPlatform
  platformUserId String?
  accountName    String
  accessToken    String // AES-256 Encrypted
  refreshToken   String? // AES-256 Encrypted
  tokenExpiresAt DateTime?
  isConnected    Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, platform])
  @@index([userId])
}

model BrandKit {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName    String
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  logoUrl         String?
  avatarUrl       String?
  phone           String?
  whatsapp        String?
  email           String?
  instagramHandle String?
  facebookHandle  String?
  address         String?
  city            String?
  state           String?
  country         String?   @default("India")
  websiteUrl      String?
  tagline         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([categoryId])
}

model Frame {
  id            String   @id @default(uuid())
  title         String
  description   String?
  overlayPngUrl String   // Cloudinary PNG URL of transparent frame overlay WITHOUT text
  previewUrl    String?  // Cloudinary PNG URL of frame preview WITH sample text
  configJson    Json?    // Vector shapes, slots, fonts, and positions JSON config
  isSystem      Boolean  @default(true)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BrandAsset {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetType          AssetType @default(PRODUCT_PHOTO)
  fileUrl            String
  fileName           String
  mimeType           String
  fileSize           Int
  cloudinaryPublicId String?
  createdAt          DateTime  @default(now())

  @@index([userId])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brandKits BrandKit[]
  posts     Post[]
}

model Festival {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?
  date         DateTime
  targetRegion String?  @default("India")
  bannerUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  templates Template[]
  posts     Post[]
}

model DesignStyle {
  id              String   @id @default(uuid())
  name            String   @unique
  slug            String   @unique
  description     String?
  primaryColor    String   @default("#F59E0B")
  secondaryColor  String   @default("#0D9488")
  accentColor     String   @default("#EC4899")
  backgroundColor String   @default("#0B0F17")
  gradient        String?
  fontHeader      String   @default("Space Grotesk")
  fontBody        String   @default("Plus Jakarta Sans")
  colors          String[] @default([])
  rulesJson       Json?
  isSystem        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  posts Post[]
}

model TemplateCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?  @default("🎨")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  templates Template[]
}

model Template {
  id                 String            @id @default(uuid())
  title              String
  description        String?
  category           String            @default("GENERAL")
  templateCategoryId String?
  templateCategory   TemplateCategory? @relation(fields: [templateCategoryId], references: [id], onDelete: SetNull)
  festivalId         String?
  festival           Festival?         @relation(fields: [festivalId], references: [id], onDelete: SetNull)
  baseImageUrl       String
  isCustomUpload     Boolean           @default(true)
  isActive           Boolean           @default(true)
  createdBy          String?
  creator            User?             @relation("TemplateCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  posts Post[]

  @@index([festivalId])
  @@index([category])
  @@index([templateCategoryId])
}

model Post {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId      String?
  template        Template?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  festivalId      String?
  festival        Festival?    @relation(fields: [festivalId], references: [id], onDelete: SetNull)
  styleId         String?
  style           DesignStyle? @relation(fields: [styleId], references: [id], onDelete: SetNull)
  occasionName    String?
  customText      String?
  offerText       String?
  customImageUrl  String? // Local system upload URL / swapped image URL
  finalGraphicUrl String? // Sharp server-side composited render URL
  userConfigJson  Json?   // Per-user post instance vector JSON config
  status          PostStatus   @default(DRAFT)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  captions       Caption[]
  scheduledPosts ScheduledPost[]
  vaultItems     VaultItem[]

  @@index([userId])
  @@index([status])
}

model Caption {
  id          String         @id @default(uuid())
  postId      String
  post        Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform    SocialPlatform
  captionText String
  hashtags    String[]
  isApproved  Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([postId, platform])
  @@index([postId])
}

model ScheduledPost {
  id              String           @id @default(uuid())
  postId          String
  post            Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime
  publishedAt     DateTime?
  status          PublishStatus    @default(PENDING)
  errorMessage    String?
  retryCount      Int              @default(0)
  targetPlatforms SocialPlatform[]
  platformResults Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([postId])
  @@index([status, scheduledAt])
}

model VaultItem {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId       String
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  graphicUrl   String
  categoryName String?
  occasionName String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Subscription {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               PlanType @default(FREE)
  status             String   @default("ACTIVE")
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(SYSTEM_ALERT)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}
