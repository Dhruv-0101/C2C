// ==============================================================================
// 🎨 BRANDFLOW DATABASE SCHEMA (PostgreSQL + Prisma ORM)
// ==============================================================================
// Description: Multi-tenant, enterprise-grade schema for BrandFlow — AI-powered
// social media automation, brand kit management, festival graphics, multi-platform
// scheduling, and analytics for small businesses.
// ==============================================================================

generator client {
  provider      = "prisma-client-js"
  // Binary targets enable cross-platform support (Local macOS & Linux Alpine/musl Docker containers)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================================================================
// 🏷️ ENUMS (Global Enumerations)
// ==============================================================================

// 👥 User Roles for Role-Based Access Control (RBAC)
enum Role {
  END_USER   // Small business owner / customer who creates and schedules posts
  ADMIN      // Platform owner with complete root access to all data and settings
  SUB_ADMIN  // Staff/Support admin with permissions restricted by allowedTabs
}

// 🌐 Supported Social Media Publishing Networks
enum SocialPlatform {
  INSTAGRAM  // Meta Instagram Graph API (Feed, Carousels, Stories)
  FACEBOOK   // Meta Facebook Pages API
  LINKEDIN   // LinkedIn Community Management API
  TWITTER    // X / Twitter API v2
  PINTEREST  // Pinterest Board Pin API
  THREADS    // Meta Threads API
  WHATSAPP   // WhatsApp Business Cloud API
}

// 📁 Types of Media Assets Uploaded by Users to their Brand Asset Library
enum AssetType {
  LOGO           // Official business logo (PNG with transparency preferred)
  PRODUCT_PHOTO  // Product showcase image for marketing creatives
  BACKGROUND     // Custom textured or branded background graphic
  STORE_PHOTO    // Physical shop / office exterior or interior photo
  OTHER          // Miscellaneous user-uploaded graphic asset
}

// 🎨 Lifecycle Status of a Creative Post Asset
enum PostStatus {
  DRAFT       // Creative drafted or saved by user; not yet queued for publishing
  SCHEDULED   // Post scheduled with a future publish date & time
  PUBLISHING  // Actively being processed and uploaded by BullMQ background worker
  PUBLISHED   // Successfully published to all selected social media platforms
  FAILED      // Image generation, rendering, or dispatch permanently failed
}

// ⏰ Dispatch Status of an Individual Scheduled Event
enum PublishStatus {
  PENDING     // Waiting in queue for the scheduled date/time to arrive
  PROCESSING  // Picked up by BullMQ worker; currently making external social API calls
  SUCCESS     // Successfully posted to all target social platforms
  FAILED      // API dispatch failed (e.g. expired OAuth token, API rate limit)
}

// 💳 SaaS Monetization & Pricing Subscription Tiers
enum PlanType {
  FREE        // Free trial tier with limited post quota per month
  PRO         // Standard monthly/yearly plan for active small businesses
  ENTERPRISE  // High-volume tier for marketing agencies & multi-location franchises
}

// 🔔 Notification Alert Categories for In-App Notification Center
enum NotificationType {
  POST_PUBLISHED  // Alert when a scheduled post goes live successfully
  POST_FAILED     // Urgent alert if a social media platform rejected the post
  SYSTEM_ALERT    // Platform maintenance, terms updates, or security warnings
  BILLING         // Quota low warnings, invoice receipts, subscription renewals
}

// ==============================================================================
// 👤 USER MANAGEMENT & AUTHENTICATION
// ==============================================================================

// 👤 Central User Account Model: Stores credentials, profile, and security settings
model User {
  id                 String   @id @default(uuid())
  email              String   @unique                  // Primary login identifier
  passwordHash       String?                           // bcrypt hashed password (null for Google SSO users)
  fullName           String                            // Business owner / user's display name
  role               Role     @default(END_USER)       // RBAC role (END_USER, ADMIN, SUB_ADMIN)
  isAdmin            Boolean  @default(false)          // Quick boolean flag for admin dashboard check
  isSuperAdmin       Boolean  @default(false)          // Root admin flag with billing/user deletion power
  isSubAdmin         Boolean  @default(false)          // Sub-admin flag for customer support team
  allowedTabs        String[] @default([])             // Granular tab permissions for sub-admins (e.g. ["posts", "templates"])
  isTwoFactorEnabled Boolean  @default(false)          // Flag indicating whether TOTP 2FA is active
  twoFactorSecret    String?                           // Base32 secret key for Google Authenticator / Authy
  backupCodes        String[] @default([])             // Hashed emergency one-time recovery codes
  isGoogleRegistered Boolean  @default(false)          // True if user signed up via Google OAuth SSO
  googleId           String?  @unique                  // Unique Google OAuth account identifier (sub)
  isActive           Boolean  @default(true)           // Account status; if false, publishing & logins are blocked
  avatarUrl          String?                           // Cloudinary URL for user profile picture
  createdAt          DateTime @default(now())          // Timestamp when user registered
  updatedAt          DateTime @updatedAt               // Timestamp of last profile update

  // --- Database Relationships ---
  refreshTokens       RefreshToken[]                   // Active device sessions for JWT token rotation
  passwordResetTokens PasswordResetToken[]             // Temporary tokens for forgot-password workflow
  socialAccounts      SocialAccount[]                  // Connected social profiles (Instagram, FB, LinkedIn)
  brandKit            BrandKit?                        // Business branding profile (1-to-1 relationship)
  brandAssets         BrandAsset[]                     // Uploaded custom logos, product photos, stickers
  posts               Post[]                           // Creative posts created by this user
  vaultItems          VaultItem[]                      // Bookmarked / saved favorite graphics in user vault
  subscription        Subscription?                    // Active subscription plan and post quotas
  billingTransactions BillingTransaction[]             // Payment audit ledger (Razorpay / Stripe)
  notifications       Notification[]                   // In-app alerts and delivery statuses
  templatesCreated    Template[]           @relation("TemplateCreator") // Templates created if user is admin
  postAnalytics       PostAnalytics[]                  // Aggregated social media engagement metrics

  @@index([email])
  @@index([googleId])
  @@index([role])
}

// 🔐 JWT Refresh Token Session Store (Implements Refresh Token Rotation & Multi-Device Logout)
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String                                    // Foreign key referencing User
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique                          // SHA-256 hash of refresh token (never store raw token)
  revoked   Boolean  @default(false)                  // Revocation flag for logout or token reuse detection
  expiresAt DateTime                                  // Session expiration (e.g. 7 days from issue)
  createdAt DateTime @default(now())

  @@index([userId])
}

// 🔑 Password Reset Token Store (Time-Limited Magic Link Tokens)
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String                                    // Foreign key referencing User
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique                          // SHA-256 hash of random reset token
  used      Boolean  @default(false)                  // Prevents replay attacks (token valid only once)
  expiresAt DateTime                                  // Short expiry (e.g. 1 hour)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}

// 🔗 Connected Social Media Accounts (OAuth 2.0 Tokens & Channel Profiles)
model SocialAccount {
  id             String         @id @default(uuid())
  userId         String                               // Foreign key referencing User
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       SocialPlatform                       // Platform type (INSTAGRAM, FACEBOOK, etc.)
  platformUserId String?                              // ID given by social network (e.g. Instagram Account ID)
  accountName    String                               // Social page name / @handle displayed in UI
  accessToken    String                               // AES-256 encrypted OAuth access token
  refreshToken   String?                              // AES-256 encrypted OAuth refresh token (if supported)
  tokenExpiresAt DateTime?                            // Token expiry date for automatic background refresh
  isConnected    Boolean        @default(true)        // Toggle flag to enable or pause auto-publishing
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, platform])                       // 1 account per platform per user
  @@index([userId])
}

// ==============================================================================
// 🏢 BRAND IDENTITY & ASSETS
// ==============================================================================

// 🎨 Brand Kit: Stores small business identity automatically stamped onto posters
model BrandKit {
  id              String    @id @default(uuid())
  userId          String    @unique                   // 1 BrandKit per User
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName    String                              // Official shop / company name (e.g. "Sharma Sweets")
  categoryId      String?                             // Business niche / industry category
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  logoUrl         String?                             // Transparent logo stamped on poster corners
  avatarUrl       String?                             // Secondary brand photo or owner portrait
  phone           String?                             // Primary customer contact number
  whatsapp        String?                             // WhatsApp business number for direct CTA
  email           String?                             // Public business email displayed on posters
  instagramHandle String?                             // @instagram_handle shown on creative footer
  facebookHandle  String?                             // Facebook page handle / URL
  address         String?                             // Physical shop address line
  city            String?                             // City (e.g. Mumbai, Delhi, Bengaluru)
  state           String?                             // State (e.g. Maharashtra, Karnataka)
  country         String?   @default("India")
  websiteUrl      String?                             // Company website URL
  tagline         String?                             // Catchy business slogan (e.g. "Pure Taste Since 1985")
  primaryFont     String?                             // Selected Google Font for headings (e.g. "Montserrat")
  secondaryFont   String?                             // Selected Google Font for contact details
  targetAudience  String?                             // Audience profile used for AI caption generation
  captionLanguage String?   @default("English")       // Preferred caption language (Hindi, English, Hinglish)
  businessUsps    String?                             // Unique Selling Points for promotional copy
  linkedinHandle  String?                             // LinkedIn company page handle
  twitterHandle   String?                             // X / Twitter handle
  youtubeHandle   String?                             // YouTube channel link
  gmbReviewUrl    String?                             // Google My Business review short-link
  upiVpa          String?                             // UPI ID for payment QR code (e.g. shop@upi)
  upiQrUrl        String?                             // Pre-generated UPI QR code graphic URL
  workingHours    String?                             // Store opening hours (e.g. "10:00 AM - 9:00 PM")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([categoryId])
}

// 🖼️ Poster Frames / Overlays: Decorative borders & badges blended onto poster graphics
model Frame {
  id            String   @id @default(uuid())
  title         String                                // Frame name (e.g. "Festive Gold Border", "Modern Minimal")
  description   String?                               // Description of frame theme
  overlayPngUrl String                                // Transparent PNG overlay URL composited over images via Sharp
  previewUrl    String?                               // Frame preview with mock business details for UI picker
  configJson    Json?                                 // Coordinate slots (logo X/Y, text positions, colors)
  isSystem      Boolean  @default(true)               // True for default platform frames; false for user frames
  isActive      Boolean  @default(true)               // Toggle visibility in template editor
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 📁 Uploaded Brand Asset Files: Custom media stored on Cloudinary
model BrandAsset {
  id                 String    @id @default(uuid())
  userId             String                           // Foreign key referencing User
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetType          AssetType @default(PRODUCT_PHOTO) // LOGO, PRODUCT_PHOTO, BACKGROUND, etc.
  fileUrl            String                           // CDN URL of uploaded asset
  fileName           String                           // Original filename uploaded by user
  mimeType           String                           // image/png, image/jpeg, image/webp
  fileSize           Int                              // Size in bytes
  cloudinaryPublicId String?                          // Cloudinary public asset ID for deletion & transformations
  createdAt          DateTime  @default(now())

  @@index([userId])
}

// ==============================================================================
// 📂 TAXONOMY, FESTIVALS & TEMPLATES
// ==============================================================================

// 🏬 Business Categories / Niches (e.g. Restaurant, Healthcare, Real Estate, Education)
model Category {
  id          String   @id @default(uuid())
  name        String   @unique                        // Industry name (e.g. "Hospitality & Food")
  slug        String   @unique                        // URL-friendly slug (e.g. "hospitality-food")
  description String?                                 // Industry description for AI context
  icon        String?                                 // Emoji or Lucide icon identifier (e.g. "Utensils")
  isSystem    Boolean  @default(true)                 // System preset vs custom category
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brandKits BrandKit[]                                // Brand kits associated with this category
  posts     Post[]                                    // Posts generated under this category
}

// 🎆 Festivals & National Observances (e.g. Diwali, Eid, Independence Day, Holi)
model Festival {
  id           String   @id @default(uuid())
  name         String                                 // Festival name (e.g. "Diwali 2026")
  slug         String   @unique                       // URL slug (e.g. "diwali-2026")
  description  String?                                // Cultural significance and context
  date         DateTime                               // Date when festival occurs (for chronological sorting)
  targetRegion String?  @default("India")             // Regional focus (e.g. "India", "Global", "Maharashtra")
  bannerUrl    String?                                // Header banner for festival spotlight on dashboard
  isActive     Boolean  @default(true)                // Toggle to display or hide on upcoming calendar
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  templates Template[]                                // Graphic templates available for this festival
  posts     Post[]                                    // User posts created for this festival
}

// 🎨 Template Categories (Grouping templates by visual theme: Festive, Sale, Hiring, Motivation)
model TemplateCategory {
  id          String   @id @default(uuid())
  name        String   @unique                        // Category title (e.g. "Promotional Offers", "Daily Quotes")
  slug        String   @unique                        // URL slug (e.g. "promotional-offers")
  description String?
  icon        String?  @default("🎨")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  templates Template[]
}

// 🖼️ Master Graphic Poster Templates: Ready-made artwork for users to customize
model Template {
  id                 String            @id @default(uuid())
  title              String                           // Template name (e.g. "Happy Diwali Gold Sparkle")
  description        String?
  category           String            @default("GENERAL") // Legacy string category tag
  templateCategoryId String?                          // Foreign key referencing TemplateCategory
  templateCategory   TemplateCategory? @relation(fields: [templateCategoryId], references: [id], onDelete: SetNull)
  festivalId         String?                          // Optional link if template is festival-specific
  festival           Festival?         @relation(fields: [festivalId], references: [id], onDelete: SetNull)
  baseImageUrl       String                           // Cloudinary background artwork URL
  isCustomUpload     Boolean           @default(true) // True if uploaded by admin via dashboard
  isActive           Boolean           @default(true) // Soft toggle for template visibility
  createdBy          String?                          // Admin user ID who uploaded this template
  creator            User?             @relation("TemplateCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  posts Post[]                                        // User posts created from this template

  @@index([festivalId])
  @@index([category])
  @@index([templateCategoryId])
}

// ==============================================================================
// 📢 POST CREATION, CAPTIONS & SCHEDULING
// ==============================================================================

// 🖼️ Creative Post Asset: Represents a customized marketing poster generated by a user
model Post {
  id              String       @id @default(uuid())
  userId          String                              // Foreign key referencing User who owns this post
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId      String?                             // Optional foreign key to source Template
  template        Template?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  categoryId      String?                             // Optional industry niche tag
  category        Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  festivalId      String?                             // Optional festival tag
  festival        Festival?    @relation(fields: [festivalId], references: [id], onDelete: SetNull)
  occasionName    String?                             // Free-text occasion title (e.g. "Grand Opening Sale")
  customText      String?                             // User's custom headline stamped on poster
  offerText       String?                             // Discount / deal text (e.g. "FLAT 20% OFF TODAY")
  customImageUrl  String?                             // User-uploaded product or swapped graphic URL
  finalGraphicUrl String?                             // Sharp composited high-res rendered final image URL
  userConfigJson  Json?                               // Coordinate positions, colors, font sizes for re-editing
  status          PostStatus   @default(DRAFT)        // Post lifecycle state (DRAFT, SCHEDULED, PUBLISHED, etc.)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  captions       Caption[]                            // Multi-platform AI generated captions
  scheduledPosts ScheduledPost[]                      // Scheduled publishing events (1-to-Many)
  vaultItems     VaultItem[]                          // Saved copies in user's vault
  postAnalytics  PostAnalytics[]                      // Social performance analytics

  @@index([userId])
  @@index([status])
}

// ✍️ Social Captions: AI-generated copy & viral hashtags tailored per social channel
model Caption {
  id          String         @id @default(uuid())
  postId      String                                  // Foreign key referencing Post
  post        Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform    SocialPlatform                          // Platform for which caption was optimized
  captionText String                                  // Marketing copy / text generated by Gemini AI
  hashtags    String[]                                // Trending hashtags (e.g. ["#DiwaliSale", "#ShopLocal"])
  isApproved  Boolean        @default(true)           // User approval flag before automated dispatch
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([postId, platform])                        // 1 caption per platform per post
  @@index([postId])
}

// ⏰ Scheduled Publishing Dispatcher: Manages when and where posts are sent live
model ScheduledPost {
  id              String           @id @default(uuid()) // Unique Dispatch Event ID (scheduledPostId)
  postId          String                               // Foreign key referencing parent Post content
  post            Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime                             // Target timestamp when post must be published
  publishedAt     DateTime?                            // Exact timestamp when social APIs returned 200 OK
  status          PublishStatus    @default(PENDING)   // PENDING -> PROCESSING -> SUCCESS / FAILED
  errorMessage    String?                              // Human-readable error message if dispatch failed
  retryCount      Int              @default(0)         // Number of retry attempts made by worker
  targetPlatforms SocialPlatform[]                     // Target networks: ["INSTAGRAM", "FACEBOOK", "LINKEDIN"]
  platformResults Json?                                // Raw API response payloads / remote post IDs from Meta/LinkedIn
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([postId])
  @@index([status, scheduledAt])                     // Composite index optimizing 60-second cron polling query
}

// 🗄️ Creative Vault: Saved favorite graphics for quick re-use & brand archive
model VaultItem {
  id           String   @id @default(uuid())
  userId       String                                 // Foreign key referencing User
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId       String                                 // Foreign key referencing Post
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  graphicUrl   String                                 // Permanent image URL of saved poster
  categoryName String?                                // Snapshot of category name for offline filtering
  occasionName String?                                // Snapshot of occasion title
  createdAt    DateTime @default(now())

  @@index([userId])
}

// ==============================================================================
// 💳 SUBSCRIPTIONS, QUOTAS & BILLING AUDIT
// ==============================================================================

// 📦 Subscription & Post Quota Tracker (Enforces SaaS monetization limits)
model Subscription {
  id                 String    @id @default(uuid())
  userId             String    @unique                 // 1 active subscription record per User
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               PlanType  @default(FREE)          // FREE, PRO, or ENTERPRISE
  status             String    @default("ACTIVE")      // ACTIVE, EXPIRED, CANCELLED
  totalPostsAllowed  Int       @default(5)             // Monthly quota limit of graphics user can generate
  postsUsed          Int       @default(0)             // Number of quota posts consumed in current period
  bonusPostsAllowed  Int       @default(0)             // Extra bonus post credits granted by admin/promotion
  bonusPostsUsed     Int       @default(0)             // Number of bonus credits consumed
  pricePaid          Float     @default(0)             // Amount charged for current active billing cycle
  currency           String    @default("INR")         // Currency code (INR, USD)
  paymentGateway     String?                           // RAZORPAY, STRIPE, FREE, ADMIN_BONUS
  paymentId          String?                           // Payment gateway transaction ID
  orderId            String?                           // Gateway order ID (e.g. order_xxx)
  currentPeriodStart DateTime  @default(now())         // Cycle start date
  currentPeriodEnd   DateTime?                         // Expiration / renewal date (null for lifetime free)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// 🔔 In-App Notification Center: Alerts delivered to user dashboard & mobile bell icon
model Notification {
  id        String           @id @default(uuid())
  userId    String                                    // Foreign key referencing recipient User
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String                                    // Short headline (e.g. "Post Published Successfully! 🎉")
  message   String                                    // Descriptive alert message
  type      NotificationType @default(SYSTEM_ALERT)    // POST_PUBLISHED, POST_FAILED, BILLING, SYSTEM_ALERT
  isRead    Boolean          @default(false)          // Read/Unread badge indicator
  createdAt DateTime         @default(now())

  @@index([userId, isRead])                          // Composite index for fast unread count queries
}

// 🧾 Billing Transactions Ledger: Immutable financial transaction history
model BillingTransaction {
  id              String   @id @default(uuid())
  userId          String                              // Foreign key referencing User
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            PlanType @default(FREE)             // Tier purchased
  transactionType String   @default("PLAN_ACTIVATION")// PLAN_ACTIVATION, PLAN_PURCHASE, ADMIN_BONUS
  paymentGateway  String                              // Gateway provider: FREE, RAZORPAY, STRIPE
  pricePaid       Float    @default(0)                // Amount billed
  currency        String   @default("INR")            // Currency code
  postCount       Int      @default(0)                // Number of post credits allocated in this invoice
  paymentId       String?                             // Gateway payment ID (e.g. pay_xxx / ch_xxx)
  orderId         String?                             // Gateway order ID (e.g. order_xxx)
  status          String   @default("COMPLETED")      // COMPLETED, PENDING, FAILED, REFUNDED
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ==============================================================================
// 📊 SOCIAL PERFORMANCE & ENGAGEMENT ANALYTICS
// ==============================================================================

// 📈 Post Analytics: Tracks engagement metrics synced from Meta Graph & LinkedIn APIs
model PostAnalytics {
  id             String         @id @default(uuid())
  postId         String                               // Foreign key referencing Post
  post           Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId         String                               // Foreign key referencing User
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       SocialPlatform                       // Social network where metrics were collected
  platformPostId String?                              // Remote platform post ID returned by Instagram/FB API

  impressions    Int            @default(0)           // Total views count (screen appearances)
  reach          Int            @default(0)           // Unique individual users who saw the post
  likes          Int            @default(0)           // Likes / reactions count
  comments       Int            @default(0)           // Comments count
  shares         Int            @default(0)           // Shares / retweets count
  clicks         Int            @default(0)           // Link / sticker clicks count
  engagementRate Float          @default(0.0)         // (Likes + Comments + Shares) / Impressions * 100

  lastSyncedAt   DateTime       @default(now())       // Last time metrics were fetched from social APIs
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([postId, platform])                        // 1 analytics record per platform per post
  @@index([userId, platform])
  @@index([createdAt])
}
